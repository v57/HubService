{
  "header": {
    "type": "app",
    "name": "Demo",
    "path": "demo",
    "icon": "chart.bar",
    "widget": {
      "sizes": [
        "1x1",
        "2x2"
      ]
    }
  },
  "body": [
    "Plain text",
    {
      "type": "text",
      "value": "$title",
      "secondary": true,
      "style": "title",
      "color": "blue"
    },
    {
      "type": "markdown",
      "value": "**Bold** and [a link](https://example.com)"
    },
    {
      "type": "image",
      "url": "$avatar",
      "width": 40,
      "height": 40,
      "mode": "fill",
      "cornerRadius": 20
    },
    {
      "type": "image",
      "symbol": "star.fill",
      "color": "#ffaa00"
    },
    {
      "type": "badge",
      "value": "$status",
      "color": "$statusColor"
    },
    {
      "type": "divider"
    },
    {
      "type": "link",
      "title": "Docs",
      "url": "https://example.com",
      "icon": "book"
    },
    {
      "type": "stat",
      "title": "Users",
      "value": "$users",
      "unit": "k",
      "delta": "$usersDelta",
      "deltaFormat": "percent",
      "positive": "up",
      "sparkline": "$usersHistory",
      "icon": "person.2",
      "color": "green"
    },
    {
      "type": "gauge",
      "value": "$cpu",
      "min": 0,
      "max": 100,
      "title": "CPU",
      "label": "$cpuLabel",
      "style": "semicircle",
      "color": "blue",
      "thresholds": [
        {
          "value": 80,
          "color": "red"
        }
      ]
    },
    {
      "type": "chart",
      "kind": "line",
      "series": [
        {
          "name": "In",
          "data": "$in",
          "color": "blue"
        },
        {
          "name": "Out",
          "data": [
            [
              1,
              2
            ],
            [
              2,
              3
            ]
          ]
        }
      ],
      "title": "Traffic",
      "x": "time",
      "height": 160,
      "legend": true,
      "yMin": 0,
      "yMax": 10,
      "unit": "MB/s"
    },
    {
      "type": "chart",
      "kind": "bar",
      "series": [
        {
          "name": "Signups",
          "data": [
            {
              "x": "Mon",
              "y": 3
            },
            {
              "x": "Tue",
              "y": 5
            }
          ]
        }
      ],
      "stacked": true,
      "x": "category"
    },
    {
      "type": "chart",
      "kind": "area",
      "series": [
        {
          "name": "Load",
          "data": [
            1,
            2,
            3
          ]
        }
      ]
    },
    {
      "type": "chart",
      "kind": "donut",
      "series": [
        {
          "name": "Platforms",
          "data": [
            {
              "label": "iOS",
              "value": 3
            },
            {
              "label": "Android",
              "value": 2
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "data": "$rows",
      "columns": [
        {
          "title": "name",
          "key": "name"
        },
        {
          "title": "Status",
          "key": "status",
          "align": "trailing",
          "style": "badge"
        }
      ]
    },
    {
      "type": "grid",
      "content": [
        {
          "type": "stat",
          "title": "A",
          "value": 1
        },
        {
          "type": "stat",
          "title": "B",
          "value": 2
        }
      ],
      "columns": 2,
      "minWidth": 120,
      "spacing": 8
    },
    {
      "type": "section",
      "title": "Section",
      "content": [
        "inside"
      ],
      "subtitle": "Subtitle",
      "style": "plain"
    },
    {
      "type": "tabs",
      "tabs": [
        {
          "title": "Day",
          "content": [
            "day"
          ],
          "icon": "sun.max"
        },
        {
          "title": "Week",
          "content": [
            "week"
          ]
        }
      ],
      "selected": "range",
      "style": "segmented"
    },
    {
      "type": "sheet",
      "title": "Details",
      "content": [
        "in a sheet"
      ],
      "icon": "info.circle"
    },
    {
      "type": "button",
      "title": "Delete",
      "action": {
        "path": "demo/delete",
        "body": "id"
      },
      "icon": "trash",
      "style": "destructive",
      "confirm": {
        "title": "Delete?",
        "message": "For good",
        "button": "Delete",
        "destructive": true
      }
    },
    {
      "type": "button",
      "title": "Refresh",
      "action": {
        "path": "demo/refresh"
      }
    },
    {
      "type": "hstack",
      "content": [
        {
          "type": "cell",
          "title": "$title",
          "subtitle": "$subtitle"
        },
        {
          "type": "spacer"
        },
        {
          "type": "progress",
          "value": "progress",
          "min": 0,
          "max": 100
        }
      ],
      "spacing": 8
    },
    {
      "type": "vstack",
      "content": [
        {
          "type": "textField",
          "value": "name",
          "placeholder": "Name"
        },
        {
          "type": "slider",
          "value": "volume",
          "min": 0,
          "max": 10,
          "step": 1
        },
        {
          "type": "picker",
          "options": [
            "a",
            "b"
          ],
          "selected": "choice"
        }
      ]
    },
    {
      "type": "zstack",
      "content": [
        "back",
        "front"
      ]
    },
    {
      "type": "list",
      "data": "rows",
      "content": {
        "type": "cell",
        "title": "$name",
        "subtitle": "$status"
      }
    }
  ],
  "data": {
    "title": "Demo",
    "avatar": "https://example.com/a.png",
    "status": "Healthy",
    "statusColor": "green",
    "users": 12.5,
    "usersDelta": 0.12,
    "usersHistory": [
      1,
      3,
      2,
      5
    ],
    "cpu": 42,
    "cpuLabel": "42%",
    "in": [
      [
        1760000000000,
        1
      ],
      [
        1760000060000,
        4
      ]
    ],
    "rows": [
      {
        "name": "api",
        "status": "up"
      },
      {
        "name": "db",
        "status": "down"
      }
    ],
    "progress": 40,
    "range": "Day"
  },
  "widget": {
    "body": [
      {
        "type": "stat",
        "title": "Users",
        "value": "$users",
        "sparkline": "$usersHistory"
      }
    ],
    "1x1": [
      {
        "type": "gauge",
        "value": "$cpu",
        "max": 100
      }
    ]
  }
}
